{
  "name": "aeris",
  "displayName": "AERIS",
  "description": "AERIS Language Support",
  "version": "0.0.0",
  "publisher": "aeris-lang",
  "license": "MIT",
  "private": true,
  "type": "module",
  "icon": "assets/icon.png",
  "repository": "https://github.com/aeris-lang/aeris-vscode",
  "homepage": "https://aeris-lang.org",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.106.2"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {},
  "activationEvents": [
    "onLanguage:aeris"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aeris",
        "aliases": [
          "AERIS"
        ],
        "extensions": [
          ".aeris"
        ],
        "icon": {
          "dark": "assets/lettermark-light;52;64.png",
          "light": "assets/lettermark-dark;52;64.png"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check && npm run lint && tsx esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "tsx esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check && npm run lint && tsx esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vscode-test"
  },
  "dependencies": {
    "tslib": "^2.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0",
    "@types/node": "^24",
    "@types/vscode": "^1.106",
    "@typescript-eslint/eslint-plugin": "^8.47",
    "@typescript-eslint/parser": "^8.47",
    "@vscode/test-cli": "^0.0",
    "@vscode/test-electron": "^2.5",
    "@vscode/vsce": "^3.7",
    "esbuild": "^0.27",
    "eslint": "^9.39",
    "jiti": "^2.6",
    "npm-run-all": "^4.1",
    "prettier": "^3.6",
    "tsx": "^4.20",
    "typescript": "^5.9"
  }
}
