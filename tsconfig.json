{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "moduleDetection": "force",
    "module": "node16",
    "resolveJsonModule": true,
    "allowJs": false,
    "sourceMap": true,
    "importHelpers": true,
    "noEmitHelpers": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}